# Amazon Bedrock & AWS Configuration
# (Leave empty to use built-in local Strands Agent reasoning engine)
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# AWS Credentials (optional for local sandbox; required for direct Bedrock invocation)
# In production, use IAM Roles instead of long-lived access keys.
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_SESSION_TOKEN=your_session_token_here (if using temporary credentials)

# Server Configuration
PORT=8000
HOST=127.0.0.1
